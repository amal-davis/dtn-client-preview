{"lesson":{"slug":"lesson-06","title":"Day 6: conjuncts","type":"video","duration_minutes":14,"is_preview":false,"status":"completed","locked":false,"description":"In this video lesson: Day 6: conjuncts. After watching, repeat what you heard out loud.","module_title":"Days 4 to 7","index":6,"prev":{"slug":"lesson-05","title":"Day 5: chillu letters","type":"video","duration_minutes":10,"is_preview":false,"status":"completed","locked":false},"next":{"slug":"lesson-07","title":"Day 7: alphabet quiz","type":"quiz","duration_minutes":15,"is_preview":false,"status":"completed","locked":false},"resources":[],"position_seconds":0,"video":{"poster":{"src":{"url":"__PREVIEW_MEDIA__/images/academy-sample-cours_Plm92Pi.2e16d0ba.fill-1216x760.format-webp.webp","width":1200,"height":750},"alt":""},"duration_seconds":840,"chapters":[],"provider_video_id":null},"reading":null,"quiz":null,"assignment":null,"live_class":null},"course":{"course":{"slug":"malayalam-alphabet-in-7-days","title":"ഏഴു ദിവസം കൊണ്ട് അക്ഷരമാല","summary":"ഇംഗ്ലീഷിൽ വിശദീകരിക്കുന്ന സൗജന്യ കോഴ്സ്: ഒരാഴ്ചയിൽ അക്ഷരമാല.","cover_image":{"src":{"url":"__PREVIEW_MEDIA__/images/academy-sample-cours_Plm92Pi.2e16d0ba.fill-1216x760.format-webp.webp","width":1200,"height":750},"alt":"The Malayalam letter അ (placeholder image)"},"badge_label":"സൗജന്യം","series_number":5,"series_name":"മലയാളം അക്കാദമി","lesson_count":7,"duration_weeks":1,"category":"reading-writing","language":"en","level":"beginner","access":[{"type":"free"}],"availability":"open","total_video_minutes":76,"last_updated":"2026-11-12","subtitle":"ദിവസം ഒരു പാഠം: ഒരാഴ്ചയിൽ മുഴുവൻ അക്ഷരമാലയും.","unlock_mode":"open","description":["ഇംഗ്ലീഷിൽ വിശദീകരിക്കുന്ന ചെറു കോഴ്സ്. ഏഴു ദിവസം, ദിവസം ഒരു പാഠം: സ്വരങ്ങൾ, വ്യഞ്ജനങ്ങൾ, സ്വരചിഹ്നങ്ങൾ, ചില്ലുകൾ, കൂട്ടക്ഷരങ്ങൾ."],"category_name":"വായനയും എഴുത്തും","learning_outcomes":["എല്ലാ സ്വരങ്ങളും വ്യഞ്ജനങ്ങളും തിരിച്ചറിയാൻ","സ്വരചിഹ്നങ്ങൾ ചേർത്ത് വായിക്കാൻ","ചില്ലക്ഷരങ്ങൾ തിരിച്ചറിയാൻ","സാധാരണ കൂട്ടക്ഷരങ്ങൾ വായിക്കാൻ"],"audience":["മലയാളം വായിക്കാൻ തുടങ്ങുന്നവർ","ഇംഗ്ലീഷിൽ പഠിക്കാൻ ഇഷ്ടപ്പെടുന്നവർ","ഒരു ചെറിയ തുടക്കം തേടുന്നവർ"],"requirements":["ഇംഗ്ലീഷ് മനസ്സിലാകണം","ദിവസം 15 മിനിറ്റ്"],"modules":[{"title":"Days 1 to 3","lessons":[{"slug":"lesson-01","title":"Day 1: vowels","type":"video","duration_minutes":12,"is_preview":true},{"slug":"lesson-02","title":"Day 2: consonants (part 1)","type":"video","duration_minutes":14,"is_preview":true},{"slug":"lesson-03","title":"Day 3: consonants (part 2)","type":"video","duration_minutes":14,"is_preview":false}]},{"title":"Days 4 to 7","lessons":[{"slug":"lesson-04","title":"Day 4: vowel signs","type":"video","duration_minutes":12,"is_preview":false},{"slug":"lesson-05","title":"Day 5: chillu letters","type":"video","duration_minutes":10,"is_preview":false},{"slug":"lesson-06","title":"Day 6: conjuncts","type":"video","duration_minutes":14,"is_preview":false},{"slug":"lesson-07","title":"Day 7: alphabet quiz","type":"quiz","duration_minutes":15,"is_preview":false}]}],"instructor":{"name":"ഫാത്തിമ എസ്.","title":"ഭാഷാ അധ്യാപിക · സാമ്പിൾ പ്രൊഫൈൽ","bio":"ലിപിയും വ്യാകരണവും ലളിതമായി പഠിപ്പിക്കുന്നു. ഇതൊരു സാമ്പിൾ പ്രൊഫൈലാണ്: യഥാർഥ വിവരങ്ങൾ പിന്നീട് ചേർക്കും.","photo":null},"faq":[{"question":"മലയാളം വായിക്കാൻ അറിയണോ?","answer":"വേണ്ട. ഓരോ വാക്കിനും ഉച്ചാരണവും ഇംഗ്ലീഷ് അർഥവും ഉണ്ട്; ലിപി പതുക്കെ പരിചയപ്പെടാം."},{"question":"ഫോണിൽ പഠിക്കാമോ?","answer":"ഉവ്വ്. ഫോണിലും ടാബ്‌ലെറ്റിലും കമ്പ്യൂട്ടറിലും ബ്രൗസറിൽ പഠിക്കാം."},{"question":"കോഴ്സ് എത്ര കാലം കാണാൻ കഴിയും?","answer":"ചേർന്നാൽ നിങ്ങളുടെ അംഗത്വം (അല്ലെങ്കിൽ വാങ്ങിയ കോഴ്സ്) നിലനിൽക്കുന്നിടത്തോളം കാലം എല്ലാ പാഠങ്ങളും കാണാം. (സാമ്പിൾ മറുപടി: വ്യവസ്ഥകൾ ഉറപ്പിക്കണം.)"}],"related":["read-and-write-malayalam","malayalam-for-beginners","malayalam-grammar-essentials"]},"enrollment":{"course":{"slug":"malayalam-alphabet-in-7-days","title":"ഏഴു ദിവസം കൊണ്ട് അക്ഷരമാല","summary":"ഇംഗ്ലീഷിൽ വിശദീകരിക്കുന്ന സൗജന്യ കോഴ്സ്: ഒരാഴ്ചയിൽ അക്ഷരമാല.","cover_image":{"src":{"url":"__PREVIEW_MEDIA__/images/academy-sample-cou