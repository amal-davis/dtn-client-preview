വഴി ചോദിക്കാം","type":"video","duration_minutes":12,"is_preview":false},{"slug":"lesson-23","title":"ലൈവ് ക്ലാസ്: സംസാരിച്ചു നോക്കാം","type":"live_class","duration_minutes":45,"is_preview":false},{"slug":"lesson-24","title":"അവസാന ക്വിസ്","type":"quiz","duration_minutes":15,"is_preview":false}]}],"instructor":{"name":"ആശ കെ.","title":"മലയാളം അധ്യാപിക · സാമ്പിൾ പ്രൊഫൈൽ","bio":"തുടക്കക്കാർക്ക് മലയാളം പഠിപ്പിക്കുന്നതിൽ പരിചയമുള്ള അധ്യാപിക. ഇതൊരു സാമ്പിൾ പ്രൊഫൈലാണ്: യഥാർഥ വിവരങ്ങൾ പിന്നീട് ചേർക്കും.","photo":null},"faq":[{"question":"മലയാളം വായിക്കാൻ അറിയണോ?","answer":"വേണ്ട. ഓരോ വാക്കിനും ഉച്ചാരണവും ഇംഗ്ലീഷ് അർഥവും ഉണ്ട്; ലിപി പതുക്കെ പരിചയപ്പെടാം."},{"question":"ഫോണിൽ പഠിക്കാമോ?","answer":"ഉവ്വ്. ഫോണിലും ടാബ്‌ലെറ്റിലും കമ്പ്യൂട്ടറിലും ബ്രൗസറിൽ പഠിക്കാം."},{"question":"ലൈവ് ക്ലാസ് നഷ്ടപ്പെട്ടാലോ?","answer":"ലൈവ് ക്ലാസുകളുടെ റെക്കോർഡിങ് പിന്നീട് കാണാം. (സാമ്പിൾ മറുപടി: ഉറപ്പിക്കണം.)"},{"question":"കോഴ്സ് എത്ര കാലം കാണാൻ കഴിയും?","answer":"ചേർന്നാൽ നിങ്ങളുടെ അംഗത്വം (അല്ലെങ്കിൽ വാങ്ങിയ കോഴ്സ്) നിലനിൽക്കുന്നിടത്തോളം കാലം എല്ലാ പാഠങ്ങളും കാണാം. (സാമ്പിൾ മറുപടി: വ്യവസ്ഥകൾ ഉറപ്പിക്കണം.)"}],"related":["malayalam-alphabet-in-7-days","speak-malayalam-with-ease","read-and-write-malayalam"]},"related":[{"slug":"malayalam-alphabet-in-7-days","title":"ഏഴു ദിവസം കൊണ്ട് അക്ഷരമാല","summary":"ഇംഗ്ലീഷിൽ വിശദീകരിക്കുന്ന സൗജന്യ കോഴ്സ്: ഒരാഴ്ചയിൽ അക്ഷരമാല.","cover_image":{"src":{"url":"__PREVIEW_MEDIA__/images/academy-sample-cours_Plm92Pi.2e16d0ba.fill-1216x760.format-webp.webp","width":1200,"height":750},"alt":"The Malayalam letter അ (placeholder image)"},"badge_label":"സൗജന്യം","series_number":5,"series_name":"മലയാളം അക്കാദമി","lesson_count":7,"duration_weeks":1,"category":"reading-writing","language":"en","level":"beginner","access":[{"type":"free"}],"availability":"open","total_video_minutes":76,"last_updated":"2026-11-12"},{"slug":"speak-malayalam-with-ease","title":"മലയാളം അനായാസം സംസാരിക്കാം","summary":"ഉപകാരപ്രദമായ പ്രയോഗങ്ങളിലൂടെ ആത്മവിശ്വാസത്തോടെ സംസാരിക്കാം.","cover_image":{"src